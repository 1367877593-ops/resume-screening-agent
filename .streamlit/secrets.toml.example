# 将以下内容粘贴到 Streamlit Community Cloud 的 Advanced settings → Secrets。
#
# 这是**模板**，本身不含任何真实值，可以安全提交。
# 真实值只填在云端的 Secrets 界面里，不要落到仓库的任何文件中。
#
# 如果你为了本地调试创建了同目录下的 secrets.toml（去掉 .example 后缀），
# 那个文件已被 .gitignore 忽略 —— 但**不要用 `git add -f` 强行加进来**，
# 也不要把它改名后提交。密钥一旦进入 Git 历史，删文件是删不掉的，
# 必须撤销并重新签发。
LLM_PROVIDER = "deepseek"
LLM_API_KEY = "在云端界面中粘贴，不要提交到 Git"
LLM_BASE_URL = "https://api.deepseek.com"
LLM_MODEL = "deepseek-v4-pro"
LLM_MODEL_CHEAP = "deepseek-v4-flash"
LLM_THINKING_MODE = "disabled"
LLM_MAX_OUTPUT_TOKENS = 8192
LLM_TIMEOUT_SECONDS = 120
LLM_MAX_RETRIES = 3
MAX_PARALLEL_CANDIDATES = 2
DEMO_MODE = false
CACHE_ENABLED = true
SIMULATION_ENABLED = true

# 公网部署必须为 false：落库内容含简历原文，且所有访问者共用同一份库。
PERSIST_RUNS = false

# 请替换为一个与 API Key 不同的强口令，仅分享给允许使用 Demo 的人。
APP_ACCESS_CODE = "替换为至少 12 位的访问口令"
MAX_RESUMES_PER_RUN = 5
MAX_JD_CHARS = 20000
MAX_TOTAL_UPLOAD_MB = 20
