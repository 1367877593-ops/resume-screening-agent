# 复制为 .env 后填入真实值。.env 已在 .gitignore 中，不会被提交。
# 只跑演示（make demo）不需要配置本文件。

# ---------- LLM ----------
# openai | anthropic | deepseek | qwen | kimi
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=
# 出终稿用的模型
LLM_MODEL=deepseek-v4-pro
# 开发调试用的便宜模型，跑通流程用它
LLM_MODEL_CHEAP=deepseek-v4-flash
# disabled 更适合严格 JSON 输出，也能显著减少延迟与费用
LLM_THINKING_MODE=disabled
# 单次响应的 token 硬上限，防止异常输出持续消耗额度
LLM_MAX_OUTPUT_TOKENS=8192

# ---------- 反思飞轮 ----------
# 1 = Checker 的问题沉淀为经验，下次同岗位出题前注入 prompt（不额外消耗调用）
# 0 = 关闭
FLYWHEEL_ENABLED=1

# ---------- 语义一致性校验 ----------
# 1 = 匹配判定通过确定性规则后，再用 LLM 检查「证据撑不撑得起结论」（每人 1 次调用）
# 0 = 关闭，不影响主闭环
SEMANTIC_CHECK_ENABLED=1

# ---------- 三人格盲评 ----------
# 1 = 出题后跑三人格盲评（每轮多 4 次调用），0 = 关闭，不影响主闭环
SIMULATION_ENABLED=1

# ---------- 运行模式 ----------
# 1 = 全部走 data/demo_cache/ 回放，不发起真实请求；缓存未命中会显式报错
DEMO_MODE=0
# 1 = 相同输入命中缓存，避免调试时重复烧钱
CACHE_ENABLED=1

# ---------- 存储 ----------
# 1 = 每次运行落 SQLite（含简历原文），便于历史回看
# 0 = 只在内存里出结果。公网部署必须设为 0，详见 DEPLOYMENT.md
PERSIST_RUNS=1
DB_PATH=data/runtime/app.db
TRACE_DIR=data/runtime/traces
LESSONS_PATH=data/runtime/lessons.jsonl

# ---------- 调用控制 ----------
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
# 候选人之间的并发数；建议保持 2，过高会放大限流和网络波动
MAX_PARALLEL_CANDIDATES=2

# ---------- 公开部署保护 ----------
# 本地可留空；公网部署时请在平台 Secret 中设置强口令
APP_ACCESS_CODE=
MAX_RESUMES_PER_RUN=10
MAX_JD_CHARS=20000
MAX_TOTAL_UPLOAD_MB=30
